<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state: Modern Pill -->
    <item android:state_selected="true">
        <layer-list>
            <item android:width="20dp" android:height="8dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorPrimary" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state: Subtle Circle -->
    <item>
        <layer-list>
            <item android:width="8dp" android:height="8dp" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/bg_surface2" />
                    <stroke android:width="1dp" android:color="@color/divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>