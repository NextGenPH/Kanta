<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Kanta" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ── Window Styles ────────────────────────────────────────────── -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- ── Brand Colors ─────────────────────────────────────────────── -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="android:colorPrimary">@color/accent_green</item>
        <item name="android:colorAccent">@color/accent_green</item>

        <!-- ── Surface / Backgrounds ────────────────────────────────────── -->
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_surface2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- ── Typography Defaults ───────────────────────────────────────── -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- ── Toolbar / Action Bars ─────────────────────────────────────── -->
        <item name="actionBarStyle">@style/ThemeOverlay.Kanta.Toolbar</item>
        <item name="toolbarStyle">@style/ThemeOverlay.Kanta.Toolbar</item>

        <!-- ── Component Overrides ───────────────────────────────────────── -->
        <item name="alertDialogTheme">@style/KantaAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/KantaAlertDialog</item>
        <item name="materialButtonStyle">@style/KantaButton</item>
        <item name="bottomSheetDialogTheme">@style/KantaBottomSheetDialog</item>

        <!-- ── Interactivity / Touch Feedback ───────────────────────────── -->
        <item name="colorControlHighlight">@color/ripple_light_black</item>
        <item name="rippleColor">@color/ripple_light_black</item>

    </style>

    <!-- Toolbar Overlays -->
    <style name="ThemeOverlay.Kanta.Toolbar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:background">@color/bg_surface</item>
        <item name="background">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="actionMenuTextColor">@color/text_primary</item>
    </style>

    <!-- Alert Dialogs Configurations -->
    <style name="KantaAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/bg_surface2</item>
        <item name="android:windowBackground">@color/bg_surface2</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorSurface">@color/bg_surface2</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Kanta.MediumComponent</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/NeutralButtonStyle</item>
    </style>

    <style name="ShapeAppearance.Kanta.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/ripple_light_black</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NeutralButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Component Buttons Styles -->
    <style name="KantaButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_green</item>
        <item name="android:textColor">@color/bg_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="rippleColor">@color/ripple_light_black</item>
    </style>

    <!-- Bottom Sheet Panels Design -->
    <style name="KantaBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/KantaBottomSheetModal</item>
    </style>

    <style name="KantaBottomSheetModal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/bg_surface2</item>
        <item name="android:elevation">16dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Kanta.BottomSheet</item>
    </style>

    <!-- Global Corner Overlays Shapes Dimensions -->
    <style name="ShapeAppearance.Kanta.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Kanta.ThumbnailSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Kanta.ThumbnailLarge" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.Kanta.Circular" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Activity Secondary Mode Schemes Extended Blocks -->
    <style name="Theme.Kanta.Player" parent="Theme.Kanta">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Kanta.Splash" parent="Theme.Kanta">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>