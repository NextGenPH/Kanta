<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Kanta" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ── Window ───────────────────────────────────────────────────── -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- ── Brand colors ─────────────────────────────────────────────── -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green_dark</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorSecondaryVariant">@color/accent_green_dark</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="android:colorPrimary">@color/accent_green</item>
        <item name="android:colorAccent">@color/accent_green</item>

        <!-- ── Surface / background ─────────────────────────────────────── -->
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_surface2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- ── Text ─────────────────────────────────────────────────────── -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- ── Toolbar ───────────────────────────────────────────────────── -->
        <item name="actionBarStyle">@style/ThemeOverlay.Kanta.Toolbar</item>
        <item name="toolbarStyle">@style/ThemeOverlay.Kanta.Toolbar</item>

        <!-- ── Components ───────────────────────────────────────────────── -->
        <item name="alertDialogTheme">@style/KantaAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/KantaAlertDialog</item>
        <item name="materialButtonStyle">@style/KantaButton</item>
        <item name="bottomSheetDialogTheme">@style/KantaBottomSheet</item>

        <!-- ── Ripple ────────────────────────────────────────────────────── -->
        <item name="colorControlHighlight">#1A3ECF8E</item>
        <item name="rippleColor">@color/ripple_green</item>

    </style>

    <!-- ── Toolbar ────────────────────────────────────────────────────────── -->

    <style name="ThemeOverlay.Kanta.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="android:background">@color/bg_surface</item>
        <item name="background">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
    </style>

    <style name="ToolbarTitleBold" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ── Alert Dialog ───────────────────────────────────────────────────── -->

    <style name="KantaAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/bg_surface2</item>
        <item name="android:windowBackground">@color/bg_surface2</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorSurface">@color/bg_surface2</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/NeutralButtonStyle</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/ripple_green</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NeutralButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ── Buttons ────────────────────────────────────────────────────────── -->

    <style name="KantaButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_green</item>
        <item name="android:textColor">@color/bg_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="rippleColor">@color/ripple_green</item>
    </style>

    <!-- ── Bottom Sheet ───────────────────────────────────────────────────── -->

    <style name="KantaBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/KantaBottomSheetModal</item>
    </style>

    <style name="KantaBottomSheetModal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/bg_surface</item>
        <item name="android:elevation">16dp</item>
    </style>

    <!-- ── SearchView ─────────────────────────────────────────────────────── -->

    <!-- ── MaterialCardView ──────────────────────────────────────────────── -->

    <!-- Splash screen theme — windowBackground matches your dark bg -->
    <style name="Theme.Kanta.Splash" parent="Theme.Kanta">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>