<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <ImageView
        android:id="@+id/ivUpdateIcon"
        android:layout_width="@dimen/icon_size_huge"
        android:layout_height="@dimen/icon_size_huge"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:contentDescription="@string/update_available"
        android:src="@drawable/ic_launcher_foreground"
        app:tint="@color/accent_green" />

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/update_available"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_large"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:textColor="@color/accent_green"
        android:textSize="@dimen/text_normal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal"
        android:text="@string/update_whats_new"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_small"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:maxHeight="120dp">

        <TextView
            android:id="@+id/tvReleaseNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_normal" />
    </ScrollView>

    <TextView
        android:id="@+id/tvForceUpdateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal"
        android:background="#1AEE4444"
        android:padding="@dimen/spacing_small"
        android:text="@string/update_force_hint"
        android:textColor="#EE4444"
        android:textSize="@dimen/text_small"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdateNow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/btn_update_now"
        android:textColor="@color/bg_primary"
        app:backgroundTint="@color/accent_green"
        app:cornerRadius="@dimen/spacing_medium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLater"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/btn_later"
        android:textColor="@color/text_secondary" />

</LinearLayout>
