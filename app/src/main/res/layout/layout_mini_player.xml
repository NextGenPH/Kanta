<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:clickable="true"
    android:elevation="8dp"
    android:focusable="true"
    android:foreground="@color/ripple_light_black">

    <!-- Progress Indicator Bar (Pinned Flat to Top Edge) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/miniProgress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progress="0"
        app:indicatorColor="@color/accent_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="@android:color/transparent"
        app:trackThickness="2dp" />

    <!-- Thumbnail View (Strict 16:9 Aspect Frame) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/miniThumbnail"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/miniProgress"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Kanta.ThumbnailSmall"
        tools:src="@drawable/ic_thumbnail_placeholder" />

    <!-- Details Metadata Text Stack Block -->
    <LinearLayout
        android:id="@+id/layoutMiniMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/miniThumbnail"
        app:layout_constraintEnd_toStartOf="@id/btnMiniPlayPause"
        app:layout_constraintStart_toEndOf="@id/miniThumbnail"
        app:layout_constraintTop_toTopOf="@id/miniThumbnail">

        <TextView
            android:id="@+id/miniTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Song Title Goes Here" />

        <TextView
            android:id="@+id/miniArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="Artist Name" />
    </LinearLayout>

    <!-- Context Control Action: Play / Pause -->
    <ImageButton
        android:id="@+id/btnMiniPlayPause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_play_pause"
        android:padding="12dp"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnMiniClose"
        app:layout_constraintTop_toBottomOf="@id/miniProgress"
        app:tint="@color/text_primary" />

    <!-- Context Control Action: Terminate State / Close -->
    <ImageButton
        android:id="@+id/btnMiniClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_close"
        android:padding="14dp"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/miniProgress"
        app:tint="@color/text_secondary" />

</androidx.constraintlayout.widget.ConstraintLayout>