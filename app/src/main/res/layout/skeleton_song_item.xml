<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <!-- Thumbnail Skeleton (16:9 Full Bleed) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/shimmerThumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/shimmer_background"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Kanta.ThumbnailSmall" />

    <!-- Details Metadata Block Skeleton -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shimmerThumbnail">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title Line Placeholder -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:background="@color/shimmer_background"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Kanta.ThumbnailSmall" />

            <!-- Subtitle/Channel Line Placeholder -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="160dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:background="@color/shimmer_background"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Kanta.ThumbnailSmall" />
        </LinearLayout>

        <!-- More Actions Options Shape Anchor -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:background="@color/shimmer_background"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Kanta.Circular" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>