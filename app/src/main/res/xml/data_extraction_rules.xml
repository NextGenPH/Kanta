<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local Room database to prevent bloating and protect history -->
        <exclude
            domain="database"
            path="kanta_db" />
        <exclude
            domain="database"
            path="kanta_db-shm" />
        <exclude
            domain="database"
            path="kanta_db-wal" />
        <!-- Exclude preferences that might contain device-specific encrypted state -->
        <exclude
            domain="sharedpref"
            path="player_prefs.xml" />
        <exclude
            domain="sharedpref"
            path="search_history_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude local database from transfers to ensure fresh state -->
        <exclude
            domain="database"
            path="kanta_db" />
        <exclude
            domain="database"
            path="kanta_db-shm" />
        <exclude
            domain="database"
            path="kanta_db-wal" />
        <!-- Exclude preferences that might contain device-specific encrypted state -->
        <exclude
            domain="sharedpref"
            path="player_prefs.xml" />
    </device-transfer>
</data-extraction-rules>